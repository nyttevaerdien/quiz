# Admin panel password (REQUIRED, min 8 chars).
# Generate a strong one, e.g.: openssl rand -hex 24
ADMIN_PASSWORD=change_me_to_a_long_random_secret

# Admin session token lifetime in minutes (default: 480 = 8 hours)
ADMIN_TOKEN_TTL_MINUTES=480

# Login rate limit per IP (default: 5 attempts per 60 seconds)
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=60

# Comma-separated list of allowed CORS origins (default: http://localhost:3000,http://localhost:5173)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Server port (default: 5000)
PORT=5000

# SQLite database path (default: ./db/quiz.db)
# DATABASE_PATH=./db/quiz.db
